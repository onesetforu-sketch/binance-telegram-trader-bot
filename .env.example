# ─── Telegram ─────────────────────────────────────────────────────────────
# Telegram Bot Token (from @BotFather).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (get it from @userinfobot).
# IMPORTANT: if left blank/unset, the bot accepts commands from ANY Telegram
# user. Always set this in production so the bot is locked to just you.
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ─── Binance ──────────────────────────────────────────────────────────────
# Binance API credentials (https://www.binance.com/en/my/settings/api-management).
# Only required for /buy, /sell, /balance, etc. The PA strategy itself uses
# public klines (no key needed).
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# True = paper trading on Binance Testnet (recommended for first run).
# False = LIVE trading with real funds. Double-check before flipping.
USE_TESTNET=True

# ─── Price-Action Strategy ────────────────────────────────────────────────
# Symbol to analyse. Default PAXGUSDT (tokenised gold on Binance).
# PA_SYMBOL=PAXGUSDT

# Round-number level spacing in USD (e.g. 25 → 2300, 2325, 2350, ...).
# PA_ROUND_STEP=25

# Volume spike multiplier. Last closed candle volume must be ≥ this × the
# 20-bar average to qualify as a breakout.
# PA_VOLUME_SPIKE_MULT=1.5

# Minimum risk-reward ratio for auto-generated take-profits.
# PA_RR_RATIO=2.0

# Account risk per trade as a percentage (currently informational; auto-execute
# is not implemented yet — alerts only).
# PA_RISK_PCT=1.0

# How often (in minutes) the background analysis runs.
# Matches the 15m signal timeframe by default.
ANALYSIS_INTERVAL_MINUTES=15

# Path to persist PA alert state (enabled flag, last seen bias / level).
# NOTE: /tmp is wiped on reboot on most hosts. Default is a repo-local
# ./data folder; in production, point this at a persistent volume.
PA_STATE_FILE=./data/pa_state.json

# Optional: override default log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
