# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (get it from @userinfobot) - for security, only this user can use the bot
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# Binance API Keys (from https://www.binance.com/en/my/settings/api-management)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# Set to True to use Binance Testnet instead of live trading
USE_TESTNET=True

# ─── PAXG Gold Auto-Trader Settings ───────────────────────────────────────
# Maximum USDT budget per trade cycle
PAXG_TRADE_BUDGET_USDT=100

# Stop-loss percentage from average entry price
PAXG_STOP_LOSS_PCT=3.0

# Maximum portfolio drawdown before blocking new buys
PAXG_MAX_DRAWDOWN_PCT=8.0

# Minimum hours between consecutive trades (cooldown)
PAXG_COOLDOWN_HOURS=4.0

# Minimum composite score change required to trigger a new trade
PAXG_MIN_SCORE_DELTA=15.0

# How often (in minutes) the background macro analysis runs
ANALYSIS_INTERVAL_MINUTES=60

# Path to persist trading state (position, P&L, history)
PAXG_STATE_FILE=/tmp/paxg_state.json

# ─── Mobile Dashboard Bridge (server-side only) ────────────────────────────
# Generate a long, random, revocable dashboard-only key. This is NOT a Binance API key.
DASHBOARD_ACCESS_KEY=replace_with_a_long_random_dashboard_key

# For persistent hosts, use a mounted volume path instead of /tmp.
# Example: PAXG_STATE_FILE=/data/paxg_state.json
