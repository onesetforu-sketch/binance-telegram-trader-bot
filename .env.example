# ─── Telegram ─────────────────────────────────────────────────────────────
# Telegram Bot Token (from @BotFather).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (get it from @userinfobot).
# IMPORTANT: if left blank/unset, the bot accepts commands from ANY Telegram
# user. Always set this in production so the bot is locked to just you.
TELEGRAM_ALLOWED_USER_ID=your_telegram_user_id_here

# ─── Binance ──────────────────────────────────────────────────────────────
# Binance API credentials (https://www.binance.com/en/my/settings/api-management).
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# True = paper trading on Binance Testnet (recommended for first run).
# False = LIVE trading with real funds. Double-check before flipping.
USE_TESTNET=True

# ─── PAXG Gold Auto-Trader Settings ───────────────────────────────────────
# Maximum USDT budget per trade cycle.
PAXG_TRADE_BUDGET_USDT=100

# Stop-loss percentage from average entry price.
PAXG_STOP_LOSS_PCT=3.0

# Maximum portfolio drawdown (from peak) before blocking new buys.
PAXG_MAX_DRAWDOWN_PCT=8.0

# Minimum hours between consecutive trades (cooldown).
PAXG_COOLDOWN_HOURS=4.0

# Minimum composite score change required to trigger a new trade.
PAXG_MIN_SCORE_DELTA=15.0

# How often (in minutes) the background macro analysis runs.
ANALYSIS_INTERVAL_MINUTES=60

# Path to persist trading state (position, P&L, history).
# NOTE: /tmp is wiped on reboot on most hosts, which would silently erase
# your position and P&L history. Default points to a repo-local ./data
# folder; in production, set this to a persistent volume or mounted disk.
PAXG_STATE_FILE=./data/paxg_state.json

# Optional: override default log level (DEBUG, INFO, WARNING, ERROR).
# LOG_LEVEL=INFO
